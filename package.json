{
  "name": "linkassist",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node --test --test-timeout=60000 scripts/core-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "docs:generate": "node scripts/project-check.mjs --write",
    "licenses:generate": "node scripts/generate-notices.mjs",
    "check:rust-backports": "node scripts/check-rust-backports.mjs",
    "test:rust-macros": "node scripts/test-rust-macro-diagnostics.mjs",
    "audit:rust": "node scripts/audit-rust.mjs",
    "check:architecture": "node scripts/project-check.mjs",
    "check": "npm run check:architecture && npm run build && npm test",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uplot": "^1.6.32",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mingzhuuu/LinkAssist.git"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
