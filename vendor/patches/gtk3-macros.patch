+// Return a normal compiler diagnostic; no panic-based diagnostic dependency.
+macro_rules! return_error {
+    ($message:expr $(,)?) => {
+        return syn::Error::new(proc_macro2::Span::call_site(), $message)
+            .to_compile_error().into()
+    };
+    ($format:literal, $($args:tt)*) => {
+        return syn::Error::new(proc_macro2::Span::call_site(), format!($format, $($args)*))
+            .to_compile_error().into()
+    };
+}
